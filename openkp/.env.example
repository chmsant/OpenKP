# Copy this to .env and fill in your values. NEVER commit .env.
# Credentials are loaded by openkp.config.

# Kaiser Permanente username (kp.org login)
KP_USERNAME=

# Kaiser password. For better security, leave blank and store in macOS Keychain
# (the config loader falls back to keyring if this is empty).
KP_PASSWORD=

# Don't store a password at all. The login window opens and you type it
# yourself. KP_USERNAME becomes optional and KP_PASSWORD is ignored. Set to "1".
OPENKP_INTERACTIVE_LOGIN=

# Where to persist the logged-in browser profile and cookies. Defaults to ~/.openkp
OPENKP_DATA_DIR=

# Optional label for this account, reported by whoami. Useful when you run
# more than one profile (see README, "More than one Kaiser account").
OPENKP_PROFILE=

# Log level: DEBUG, INFO, WARNING, ERROR
OPENKP_LOG_LEVEL=INFO

# Safety: short-circuit any committing write tool (request_refill, send_message)
# without hitting Kaiser. Idempotent prep reads still run. Set to "1" to enable.
OPENKP_DRY_RUN=

# Dev diagnostics: when a parser returns empty (e.g. recipients/topics shape
# changed), dump the raw response to ~/.openkp/debug-*.json. Off by default
# because the recipients payload names your care team. Set to "1" to enable.
OPENKP_DEBUG_DUMPS=
